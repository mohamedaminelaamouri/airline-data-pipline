# Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# KAFKA CONFIGURATION
# ============================================
KAFKA_HOST=kafka
KAFKA_PORT=29092
KAFKA_TOPIC=airline-delays

# ============================================
# CLICKHOUSE CONFIGURATION
# ============================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=airline_data

# ============================================
# MONGODB CONFIGURATION (PC2)
# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=airline_cache
MONGODB_COLLECTION=aggregated_delays

# ============================================
# NIFI CONFIGURATION
# ============================================
NIFI_HOST=localhost
NIFI_PORT=8080
NIFI_VERSION=1.23.2

# ============================================
# KAFKA CONSUMER CONFIGURATION
# ============================================
BATCH_SIZE=1000
CONSUMER_GROUP_ID=airline-consumer-group
AUTO_OFFSET_RESET=earliest

# ============================================
# STREAMLIT CONFIGURATION
# ============================================
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0
STREAMLIT_KAFKA_GROUP_ID=airline-streamlit-ui-backfill

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log

# ============================================
# DOCKER CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=airline-pipeline
